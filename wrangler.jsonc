{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mawang-scheduler",
  "main": "src/cf-v56.js",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/media/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES"
    }
  ],
  "vars": {
    "MWS_ENV": "cloudflare-production"
  }
}
