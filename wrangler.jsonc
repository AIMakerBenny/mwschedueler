{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mawang-scheduler",
  "main": "src/cf-v571.js",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/",
      "/index.html",
      "/content-planner.html",
      "/assets/content-planner-host.js",
      "/assets/tools.js"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES"
    }
  ],
  "vars": {
    "MWS_ENV": "cloudflare-production",
    "MWS_R2_PUBLIC_BASE_URL": "https://pub-ff2081dd33384aa0865bb86b4514bbec.r2.dev"
  }
}
