{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mawang-scheduler",
  "main": "src/cf-v111-entry.js",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/api/*",
      "/assets/cloud-v5.5.js",
      "/assets/cloud-v1.1.js",
      "/assets/boss-manager-v121.js",
      "/assets/boss-raid-v116.js",
      "/majoku-castle",
      "/majoku-castle.html"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES"
    }
  ],
  "vars": {
    "MWS_ENV": "cloudflare-production",
    "MWS_R2_PUBLIC_BASE_URL": "https://pub-ff2081dd33384aa0865bb86b4514bbec.r2.dev"
  }
}
